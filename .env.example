# Minimal local env. Code defaults cover everything else — see
# backend/app/config.py and frontend/src/config/{app,review}.ts for optional
# overrides.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/japanese_review
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:8048

# Vite /api proxy target (make local overrides this).
BACKEND_DEV_ORIGIN=http://127.0.0.1:8000

# Production / pooling (uncomment when needed):
# APP_ALLOWED_ORIGINS=https://review.example
# TRUST_PROXY_HEADERS=true
# DATABASE_PREPARE_THRESHOLD=5
