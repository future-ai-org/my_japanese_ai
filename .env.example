# Minimal local env. Code defaults cover everything else — see
# backend/app/config.py, frontend/src/config/{app,review}.ts, and
# backend/inference/config.py for optional overrides.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_review
APP_ENV=development
APP_PUBLIC_ORIGIN=http://localhost:8022

# Vite /api proxy target (make local overrides this).
BACKEND_DEV_ORIGIN=http://127.0.0.1:8000

# Cloud providers: set only what you enable. Never prefix secrets with VITE_.
# Modal needs URL + key (MODAL_API_KEY must match Modal secret INFERENCE_API_KEY).
MODAL_URL=https://von-steinkirch--sakana-tinyswallow-inference-tinyswallowserver.us-east.modal.direct/v1/chat/completions
MODAL_API_KEY=
# Hugging Face needs a fine-grained token with Inference Providers access.
# HUGGINGFACE_URL defaults to the Featherless router when unset.
HUGGINGFACE_API_KEY=
# Custom OpenAI-compatible endpoint.
CUSTOM_INFERENCE_URL=
CUSTOM_INFERENCE_API_KEY=

# Production / pooling (uncomment when needed):
# APP_ALLOWED_ORIGINS=https://review.example
# TRUST_PROXY_HEADERS=true
# DATABASE_PREPARE_THRESHOLD=5

# Optional: scale Modal GPU to zero when idle (export before make modal-deploy):
# INFERENCE_MIN_CONTAINERS=0
